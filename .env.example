# Neon Postgres connection string (Neon console -> Connect -> Connection string)
DATABASE_URL=

# Any long random string - sessions are signed with this. `openssl rand -hex 32`
AUTH_SECRET=

# PASTE YOUR ANTHROPIC KEY HERE to turn on the AI coach (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Model for the coach (leave as-is unless you have a reason)
COACH_MODEL=claude-sonnet-4-5
